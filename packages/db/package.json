{
  "name": "@internationalota/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format:check": "prettier --check src test scripts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm build && node dist/migrate.js",
    "db:seed": "pnpm build && node dist/seed.js",
    "generate:reference-data": "node --experimental-strip-types scripts/generate-reference-data.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.13.3",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@internationalota/money": "workspace:*",
    "@internationalota/time": "workspace:*",
    "@types/pg": "^8.11.11",
    "currency-codes": "^2.2.0",
    "drizzle-kit": "^0.30.5",
    "i18n-iso-countries": "^7.14.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
