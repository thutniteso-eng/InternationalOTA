{
  "name": "@internationalota/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc && node dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "demo:load": "pnpm build && node dist/scripts/demo-load.js",
    "staging:cleanup-test-data": "pnpm build && node dist/scripts/staging-cleanup-test-data.js",
    "admin:grant": "pnpm build && node dist/scripts/admin-grant.js",
    "format:check": "prettier --check src test"
  },
  "dependencies": {
    "@internationalota/db": "workspace:*",
    "@internationalota/i18n": "workspace:*",
    "@internationalota/money": "workspace:*",
    "@internationalota/shared": "workspace:*",
    "@internationalota/time": "workspace:*",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-nestjs-core": "^0.72.1",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "better-auth": "1.7.28",
    "drizzle-orm": "^0.45.4",
    "nodemailer": "10.6.1",
    "pg": "^8.13.3",
    "pg-boss": "12.39.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.4.2",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.11.11",
    "pino-pretty": "^13.2.0",
    "typescript": "^5.7.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
