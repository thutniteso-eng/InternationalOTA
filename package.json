{
  "name": "internationalota",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "db:generate": "pnpm --filter @internationalota/db run db:generate",
    "db:migrate": "pnpm --filter @internationalota/db run db:migrate",
    "db:seed": "pnpm --filter @internationalota/db run db:seed",
    "db:studio": "pnpm --filter @internationalota/db exec drizzle-kit studio",
    "format": "prettier --write .",
    "format:check": "pnpm -r run format:check && prettier --check tools",
    "identity:grant-role": "pnpm --filter @internationalota/db run identity:grant-role",
    "admin:grant": "pnpm build:packages && pnpm --filter @internationalota/api run admin:grant",
    "catalog:fixtures": "pnpm --filter @internationalota/db run catalog:fixtures",
    "demo:load": "pnpm build:packages && pnpm --filter @internationalota/api run demo:load",
    "staging:cleanup-test-data": "pnpm build:packages && pnpm --filter @internationalota/api run staging:cleanup-test-data",
    "staging:outbox-cleanup": "pnpm build:packages && pnpm --filter @internationalota/api run staging:outbox-cleanup",
    "licenses:check": "node tools/check-licenses.mjs",
    "lint": "pnpm build:packages && pnpm -r run lint && eslint tools",
    "lint:boundaries": "depcruise apps/api/src --config .dependency-cruiser.cjs",
    "test": "pnpm build:packages && pnpm -r run test && vitest run tools",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.10.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
