{
  "name": "internationalota",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "format": "prettier --write .",
    "format:check": "pnpm -r run format:check",
    "lint": "pnpm build:packages && pnpm -r run lint",
    "test": "pnpm build:packages && pnpm -r run test",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck"
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
